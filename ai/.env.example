# ==============================================================================
# SHENOVA AI - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in your project root or ai/ directory and add your key:
#   cp ai/.env.example .env
#
# DO NOT commit the populated '.env' file to version control.
# ==============================================================================

# Google Gemini API Key
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model identifier (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
